# EC2 pilot image ONLY. NEVER referenced by render.yaml (GitHub/Render stays slim).
# Build on the EC2 box:  docker build -f Dockerfile.ec2 -t bhuverify:ec2 .
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-hin \
    tesseract-ocr-ori \
    poppler-utils \
    libgl1 \
    fonts-dejavu-core \
    fonts-lohit-deva \
    fonts-lohit-orya \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f >/dev/null 2>&1 || true

WORKDIR /app

COPY requirements-ec2.txt .
RUN pip install --no-cache-dir -r requirements-ec2.txt \
    && python -m spacy download en_core_web_sm

# Pre-warm HF caches so first request doesn't pay the download.
ARG HF_NER_MODEL=Davlan/xlm-roberta-base-ner-hrl
ARG HF_HTR_MODEL=microsoft/trocr-base-handwritten
ENV HF_HUB_OFFLINE=0
RUN python -c "from transformers import pipeline; pipeline('token-classification', model='$HF_NER_MODEL', aggregation_strategy='simple')" || true
RUN python -c "from transformers import TrOCRProcessor, VisionEncoderDecoderModel; TrOCRProcessor.from_pretrained('$HF_HTR_MODEL'); VisionEncoderDecoderModel.from_pretrained('$HF_HTR_MODEL')" || true

COPY . .

RUN rm -rf data && mkdir -p data/uploads data/processed data/geojson data/reports data/samples

EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
